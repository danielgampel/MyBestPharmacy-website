# Clean URLs: serve contact.html when /contact is requested, etc.
RewriteEngine On
# Canonical host: force https + non-www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.mybest-pharmacy\.com$ [NC]
RewriteRule ^(.*)$ https://mybest-pharmacy.com/$1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
